# Local bridge
SELF_CANVAS_HOST=127.0.0.1
SELF_CANVAS_PORT=8787
OUTPUT_DIR=output
SELF_CANVAS_MAX_UPLOAD_MB=1024
SELF_CANVAS_API_TOKEN=
SELF_CANVAS_ALLOWED_ORIGINS=
SELF_CANVAS_REMOTE_MEDIA_MAX_MB=64
# Additional exact private origins allowed for provider media landing, comma separated.
SELF_CANVAS_REMOTE_MEDIA_ORIGINS=
SELF_CANVAS_EXPORT_CONCURRENCY=2
SELF_CANVAS_MAX_EXPORT_QUEUE=20
SELF_CANVAS_MAX_EXPORT_GB=8
SELF_CANVAS_MIN_FREE_GB=1

# Codex MCP (generate long random values for both tokens before LAN deployment)
SELF_CANVAS_MCP_HOST=0.0.0.0
SELF_CANVAS_MCP_PORT=8790
SELF_CANVAS_MCP_TOKEN=
SELF_CANVAS_MCP_SCOPES=canvas:read,canvas:write,generation:read,generation:run,artifacts:read,artifacts:download
SELF_CANVAS_BASE_URL=http://127.0.0.1:8787
SELF_CANVAS_PUBLIC_BASE_URL=http://127.0.0.1:8787

# Redis / BullMQ
REDIS_URL=redis://127.0.0.1:6379/0
GENERATION_QUEUE_NAME=selfcanvas-generation
GENERATION_WORKER_CONCURRENCY=1
VIDEO_EDIT_QUEUE_NAME=selfcanvas-video-edit
VIDEO_EDIT_WORKER_CONCURRENCY=1
VIDEO_EDIT_JOB_TIMEOUT_MS=7200000
SELF_CANVAS_MISSING_JOB_GRACE_SECONDS=600

# Sub2API OpenAI-compatible provider
SUB2API_BASE_URL=http://10.0.0.239:3000
SUB2API_API_KEY=
SUB2API_TEXT_MODEL=gpt-4o-mini
SUB2API_IMAGE_MODEL=gpt-image-2
SUB2API_IMAGE_SIZE=1024x1024

# Direct OpenAI-compatible provider
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_TEXT_MODEL=gpt-4o-mini
OPENAI_COMPATIBLE_IMAGE_MODEL=gpt-image-2
OPENAI_COMPATIBLE_IMAGE_SIZE=1024x1024

# AnyCap CLI media provider
ANYCAP_BIN=anycap
ANYCAP_IMAGE_MODEL=nano-banana-2
ANYCAP_VIDEO_MODEL=seedance-2-fast
ANYCAP_VIDEO_MODE=text-to-video
ANYCAP_AUDIO_MODEL=doubao-seed-audio-1-0
ANYCAP_VIDEO_EDIT_MODEL=gemini-omni-flash-preview
ANYCAP_VIDEO_READ_MODEL=
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# RunningHUB workflow provider (UI reserved, worker not wired yet)
RUNNINGHUB_BASE_URL=
RUNNINGHUB_API_KEY=
