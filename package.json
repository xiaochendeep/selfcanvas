{
  "name": "canvaspro-ui-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5190",
    "server": "python3 server.py",
    "worker": "node workers/media-render-worker/index.mjs",
    "worker:video-edit": "node workers/video-edit-worker/index.mjs",
    "mcp:http": "node mcp/http.mjs",
    "mcp:stdio": "node mcp/stdio.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5191",
    "typecheck": "tsc -b --pretty",
    "test:media": "node --test workers/media-render-worker/*.test.mjs",
    "test:storyboard": "node --test workers/media-render-worker/storyboardRuntime.test.mjs",
    "test:video-edit": "node --test workers/video-edit-worker/runtime.test.mjs",
    "test:mcp": "node --test mcp/*.test.mjs",
    "test:selection": "node --experimental-strip-types --test tests/selection_policy.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xyflow/react": "12.11.1",
    "bullmq": "^5.79.2",
    "ioredis": "^5.11.1",
    "lucide-react": "1.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "undici": "7.28.0",
    "zod": "^4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "6.0.3",
    "vite": "8.1.2"
  }
}
